# ==========================================
# Production Environment Variable Blueprint
# AI Code Review & Rewrite Agent
# ==========================================

# ------------------------------------------
# AI Provider (Groq Production Settings)
# ------------------------------------------
# Required. Obtain from https://console.groq.com
GROQ_API_KEY=your_production_groq_api_key_here

# AI Model Selection
MODEL_NAME=llama-3.3-70b-versatile

# Temperature (0.0 = deterministic, optimal for code review)
TEMPERATURE=0.3

# Max tokens per completion
MAX_TOKENS=4096

# ------------------------------------------
# Server Configuration
# ------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------
# Production App Settings
# ------------------------------------------
REQUEST_TIMEOUT=30
DEBUG=false
APP_ENV=production
